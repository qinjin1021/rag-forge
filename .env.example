# ==============================================================
# 环境配置模板：复制本文件为 .env 并填入真实值
#   Windows: copy .env.example .env
# ==============================================================

# ---------- LLM配置(生成模型) ----------
# DeepSeek API Key: https://platform.deepseek.com
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---------- Embedding配置(向量化模型) ----------
# embedding_provider 两种选择:
#   local            = 本地sentence-transformers, 免费离线, 首次运行自动下载模型(约100MB), 内网可用
#   openai_compatible= 兼容OpenAI协议的Embedding API(如硅基流动 https://siliconflow.cn), 需填EMBEDDING_API_KEY
EMBEDDING_PROVIDER=local
# local模式使用的模型(bge-small-zh-v1.5: 中文优化, 512维, 轻量)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
# openai_compatible模式需要:
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_MODEL=BAAI/bge-m3

# ---------- 重排序(可选, 提升检索精度) ----------
# 开启后首次运行会下载cross-encoder模型(约1GB)
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 检索配置 ----------
TOP_K_RETRIEVE=8        # 初检召回数量
TOP_K_FINAL=4           # 重排/融合后最终送入LLM的片段数
VECTOR_WEIGHT=0.7       # 向量检索权重
BM25_WEIGHT=0.3         # 关键词检索权重

# ---------- 分块配置 ----------
CHUNK_SIZE=500          # 每块目标字符数
CHUNK_OVERLAP=80        # 相邻块重叠字符数(保证语义连贯)

# ---------- 存储路径 ----------
CHROMA_DIR=data/chroma
RAW_DOCS_DIR=data/raw_docs
